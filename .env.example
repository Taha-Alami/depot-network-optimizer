# Copy to `.env` and fill in. Never commit the real `.env`.
# Only needed when `data.source: odbc` is used; synthetic/CSV runs need nothing.

# --- ODBC connection ---------------------------------------------------------
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=your-sql-host.example.com
DB_PORT=1433
DB_DATABASE=your_database
# "yes" -> integrated (Windows) authentication, "no" -> username/password below
DB_TRUSTED_CONNECTION=no
DB_USERNAME=your_username
DB_PASSWORD=change_me
DB_ENCRYPT=yes

# --- Source tables (schema-qualified identifiers) ----------------------------
DEPOT_TABLE=your_schema.depots
ZONE_TABLE=your_schema.customer_zones
DEMAND_TABLE=your_schema.demand
INVENTORY_TABLE=your_schema.initial_inventory
RETURNS_TABLE=your_schema.returns
INFLOW_TABLE=your_schema.external_inflows
ZONE_DEPOT_DISTANCE_TABLE=your_schema.zone_depot_distances
DEPOT_DEPOT_COST_TABLE=your_schema.depot_depot_costs
TRANSPORT_RATE_TABLE=your_schema.transport_rates

# --- Optional: routing provider used to build road distance matrices --------
# ROUTING_API_KEY=dummy-key-for-your-routing-provider
